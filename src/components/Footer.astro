---
const email = "hello@energy-i.ai";

const platformLinks = [
  { label: "Platform", href: "#platform" },
  { label: "Features", href: "#how-it-works" },
  { label: "Users", href: "#who-its-for" },
  { label: "Pilot Program", href: "/join-pilot" },
];

const companyLinks = [
  {
    label: "Grid Sustain Solutions",
    href: "https://gridsustainsolutions.co.uk/",
  },
  { label: "Contact", href: "mailto:hello@energy-i.ai" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
];
---

<footer class="bg-neutral-900 text-background py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="col-span-2">
        <img
          src="/logo.svg"
          alt="Energy-i Logo"
          width="22"
          height="23"
          class="h-12 w-auto mb-4"
        />
        <p class="text-base text-background/70 mb-6 max-w-md">
          Smart Energy Management for SME's
        </p>
        <div class="space-y-2">
          <div class="text-sm text-background/60">Get started today</div>
          <a
            href={`mailto:${email}`}
            class="text-lg font-semibold text-background hover:text-primary transition-colors"
          >
            {email}
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-background mb-4">Platform</h3>
        <ul class="space-y-2">
          {
            platformLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-base font-normal text-background/70 hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-background mb-4">Company</h3>
        <ul class="space-y-2">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    link.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                  class="text-base font-normal text-background/70 hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-t border-background/15 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center"
    >
      <div class="text-sm text-background/60">
        © {new Date().getFullYear()} Energy-i. All rights reserved.
      </div>
      <div class="flex space-x-6 mt-4 md:mt-0">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-background/60 hover:text-primary transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var emailLink = document.querySelector('footer a[href^="mailto:"]');
    if (emailLink) {
      emailLink.addEventListener('click', function () {
        window.posthog?.capture('footer_email_clicked');
      });
    }
  });
</script>
