---
import { buttonVariants } from "@/components/ui/button";
import MobileNavigation from "@/components/MobileNavigation";
const BOOK_DEMO_URL = "https://calendar.app.google/kqNKoJ1XgP21c6py6";
const JOIN_PILOT_URL = "https://my.energy-i.ai/sign-up";

const navLinks = [
  { label: "Platform", href: "#platform" },
  { label: "Features", href: "#features" },
  { label: "Industries", href: "#industries" },
];
---

<header class="bg-background border-b border-border sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center gap-4 h-16">
      <div class="flex shrink-0 items-center">
        <a
          href="/"
          class="flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity"
          aria-label="Energy-i home"
        >
          <img
            src="/logo.svg"
            alt="Energy-i Logo"
            width="22"
            height="23"
            class="h-12 w-auto"
          />
          <span class="text-lg font-semibold">Energy-i</span>
        </a>
      </div>
      <nav aria-label="Main navigation" class="hidden lg:flex space-x-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-semibold text-muted-foreground hover:text-primary transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={BOOK_DEMO_URL}
          class={buttonVariants({ variant: "outline" })}
        >
          Book a demo
        </a>
        <a
          href={JOIN_PILOT_URL}
          class={buttonVariants({ variant: "default" })}
        >
          Join Pilot
        </a>
      </div>
      <div class="lg:hidden">
        <MobileNavigation
          client:load
          links={navLinks}
          bookDemoUrl={BOOK_DEMO_URL}
          joinPilotUrl={JOIN_PILOT_URL}
        />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var signupBtn = document.querySelector('a[href="https://my.energy-i.ai"]');
    if (signupBtn) {
      signupBtn.addEventListener("click", function () {
        window.posthog?.capture("signup_clicked");
      });
    }
  });
</script>
