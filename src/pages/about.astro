---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Card, CardHeader, CardContent } from "@/components/ui/card";

const founders = [
  {
    image: "/images/bilal.webp",
    name: "Bilal Islam",
    role: "Co-founder, CEO",
    linkedin: "https://www.linkedin.com/in/bilal-i-80b245211/",
    bio: "Having worked in all aspects of solar energy from surveying, designing, installing and operations, Bilal brings a wealth of practical experience to Energy-i's mission of smarter energy management.",
  },
  {
    image: "/images/mike.webp",
    name: "Mike Francis",
    role: "Co-founder, CTO",
    linkedin: "https://www.linkedin.com/in/mike-francis-77a65511/",
    bio: "With over 20 years of experience in technology and over a decade in cleantech and green energy management, Mike leads the technical vision and development at Energy-i.",
  },
];
---

<BaseLayout
  title="About | Energy-i"
  description="Learn more about Energy-i and our mission."
>
  <Header />

  <main class="bg-muted/40">
    <section
      aria-labelledby="mission-heading"
      class="bg-background py-16 lg:py-24"
    >
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid items-center gap-12 lg:grid-cols-2 lg:gap-16"
      >
        <div class="max-w-3xl space-y-6">
          <p class="text-sm text-primary font-semibold uppercase tracking-wide">
            About us
          </p>
          <h1
            id="mission-heading"
            class="text-4xl lg:text-5xl leading-tight font-semibold text-foreground"
          >
            Our mission
          </h1>
          <p
            class="text-lg lg:text-xl leading-relaxed font-light text-muted-foreground"
          >
            To make smarter energy management accessible to every small
            business.
          </p>
          <p class="text-base leading-relaxed text-muted-foreground">
            We help businesses understand where energy is wasted and turn those
            insights into practical steps to cut costs. You don't need complex
            systems or specialist knowledge, just a clearer path to using less
            energy.
          </p>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 520 380"
          width="520"
          height="380"
          role="img"
          aria-labelledby="mission-illustration-title"
          class="mx-auto h-auto w-full max-w-[520px]"
        >
          <title id="mission-illustration-title">
            People working together to reduce a small business's energy use
          </title>
          <path
            d="M22 356h476"
            stroke="#3f3d56"
            stroke-width="2"
            stroke-linecap="round"></path>
          <rect
            x="112"
            y="68"
            width="300"
            height="218"
            rx="12"
            fill="#fff"
            stroke="#3f3d56"
            stroke-width="2"></rect>
          <path d="M112 94h300" stroke="#3f3d56" stroke-width="2"></path>
          <path
            d="M128 81h44"
            stroke="#0ea5e9"
            stroke-width="4"
            stroke-linecap="round"></path>
          <g fill="#3f3d56">
            <circle cx="374" cy="81" r="3"></circle>
            <circle cx="386" cy="81" r="3"></circle>
            <circle cx="398" cy="81" r="3"></circle>
          </g>
          <path
            d="M138 122h76M138 134h48"
            stroke="#e6e6e6"
            stroke-width="6"
            stroke-linecap="round"></path>
          <path
            d="M144 246V166m0 80h134"
            fill="none"
            stroke="#3f3d56"
            stroke-width="2"></path>
          <g fill="#e6e6e6">
            <rect x="160" y="168" width="22" height="78" rx="2"></rect>
            <rect x="198" y="190" width="22" height="56" rx="2"></rect>
          </g>
          <rect x="236" y="212" width="22" height="34" rx="2" fill="#0ea5e9"
          ></rect>
          <path
            d="m160 154 47 23 47 20m-14-1 14 1-5-13"
            fill="none"
            stroke="#0ea5e9"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="343" cy="165" r="37" fill="#f0f9ff"></circle>
          <path d="m346 139-21 29h16l-3 23 23-32h-17z" fill="#0ea5e9"></path>
          <path
            d="M312 224h62M324 238h38"
            stroke="#e6e6e6"
            stroke-width="6"
            stroke-linecap="round"></path>
          <path
            d="M240 287v35m42-35v35m-63 0h84"
            fill="none"
            stroke="#3f3d56"
            stroke-width="2"
            stroke-linecap="round"></path>
          <path d="m63 342-3 12h22l-2-12m26 0 1 12h23l-11-12" fill="#2f2e41"
          ></path>
          <path d="m67 241-6 102h19l14-74 10 74h18l-3-102z" fill="#2f2e41"
          ></path>
          <path
            d="m77 158-12 10-7 76c20 8 43 9 64-1l-7-73-15-12z"
            fill="#e6e6e6"></path>
          <path d="m82 146-3 17c6 8 15 8 21-1l-3-18z" fill="#a0616a"></path>
          <circle cx="88" cy="131" r="20" fill="#a0616a"></circle>
          <path
            d="M68 134c-8-22 5-35 22-32 20-3 28 17 17 32l-6-16-13 4-6-4-5 17z"
            fill="#2f2e41"></path>
          <path
            d="m109 174 19 27 31-21"
            fill="none"
            stroke="#e6e6e6"
            stroke-width="17"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="m157 181 13-8"
            stroke="#a0616a"
            stroke-width="11"
            stroke-linecap="round"></path>
          <path
            d="m67 178-16 34 17 29"
            fill="none"
            stroke="#e6e6e6"
            stroke-width="16"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="m67 239 5 11"
            stroke="#a0616a"
            stroke-width="10"
            stroke-linecap="round"></path>
          <path d="m422 343-9 11h24l2-11m22 0 1 11h24l-10-11" fill="#2f2e41"
          ></path>
          <path d="m421 251-1 93h19l10-70 12 70h17l-3-93z" fill="#2f2e41"
          ></path>
          <path d="m434 175-13 8-5 70c18 9 41 9 62-1l-5-70-19-9z" fill="#0ea5e9"
          ></path>
          <path d="m437 158-2 19c5 8 14 8 21-1l-4-18z" fill="#ffb6b6"></path>
          <circle cx="446" cy="145" r="20" fill="#ffb6b6"></circle>
          <path
            d="M425 149c-9-17 0-32 17-34 21-4 30 11 27 29-3 17 10 24 5 31-8 7-21-1-21-12l3-23-14-5-10 15z"
            fill="#2f2e41"></path>
          <path
            d="m424 189-22 32-28-11"
            fill="none"
            stroke="#0ea5e9"
            stroke-width="17"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="m374 210-12-5"
            stroke="#ffb6b6"
            stroke-width="11"
            stroke-linecap="round"></path>
          <path
            d="m470 189 15 32-12 27"
            fill="none"
            stroke="#0ea5e9"
            stroke-width="16"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="m473 248-4 10"
            stroke="#ffb6b6"
            stroke-width="10"
            stroke-linecap="round"></path>
          <path
            d="M310 355v-28m0 17c-21 0-26-15-26-15 21-3 26 15 26 15m0-7c0-18 21-26 21-26 4 20-21 26-21 26"
            fill="#e6e6e6"></path>
        </svg>
      </div>
    </section>

    <section aria-labelledby="founders-heading" class="py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl space-y-4 mb-10">
          <h2
            id="founders-heading"
            class="text-3xl lg:text-4xl font-semibold text-foreground"
          >
            Meet the founders
          </h2>
          <p class="text-lg leading-relaxed text-muted-foreground">
            The two people behind Energy-i.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            founders.map((founder) => (
              <article aria-label={founder.name}>
                <Card className="h-full">
                  <CardHeader className="flex flex-row items-center gap-4">
                    <img
                      src={founder.image}
                      alt={founder.name}
                      width="64"
                      height="64"
                      class="size-16 shrink-0 rounded-full"
                    />
                    <div class="min-w-0 space-y-1">
                      <div class="flex items-center gap-2">
                        <h3 class="text-xl font-semibold text-foreground">
                          {founder.name}
                        </h3>
                        <a
                          href={founder.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${founder.name} on LinkedIn (opens in a new tab)`}
                          title={`${founder.name} on LinkedIn`}
                          class="inline-flex size-8 shrink-0 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="size-5"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                          </svg>
                        </a>
                      </div>
                      <p class="text-sm font-medium text-primary">
                        {founder.role}
                      </p>
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-base leading-relaxed text-muted-foreground">
                      {founder.bio}
                    </p>
                  </CardContent>
                </Card>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
