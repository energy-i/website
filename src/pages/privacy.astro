---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Badge } from "@/components/ui/badge";

const retentionRows = [
  {
    category: "Waitlist & pilot contacts",
    purpose: "Manage waitlist, send pilot invites, onboarding",
    period: "12 months after pilot completion",
    disposal: "Secure deletion",
  },
  {
    category: "Contact-form enquiries",
    purpose: "Answer questions, handle complaints",
    period: "6 months after last reply",
    disposal: "Secure deletion",
  },
  {
    category: "Marketing consents & mailing list",
    purpose: "Send newsletters & service updates",
    period: "Until consent withdrawn (review every 24 months)",
    disposal: "Delete on opt-out",
  },
  {
    category: "Analytics & IP logs",
    purpose: "Site-interaction analysis, security monitoring",
    period: "6 months",
    disposal: "Anonymise or purge logs",
  },
  {
    category: "Behavioral tracking cookies",
    purpose: "UX optimization",
    period: "3 months (per cookie banner settings)",
    disposal: "Cookie expiry + purge logs",
  },
];

const ourTransfers = [
  {
    org: "Make.com",
    category: "Integration platform",
    country: "US",
    safeguard: "The International Data Transfer Agreement (IDTA)",
  },
  {
    org: "Google",
    category: "Cloud data storage & collaboration",
    country: "Primarily US & EU",
    safeguard: "The International Data Transfer Agreement (IDTA)",
  },
];

const processorTransfers = [
  {
    org: "Make.com",
    category: "Integration platform",
    country: "US",
    safeguard: "The International Data Transfer Agreement (IDTA)",
  },
  {
    org: "Google",
    category: "Cloud data storage & collaboration",
    country: "US",
    safeguard: "The International Data Transfer Agreement (IDTA)",
  },
];
---

<BaseLayout
  title="Privacy Policy | Energy-i"
  description="How Energy-i collects, uses and protects your personal information."
>
  <Header />

  <main class="bg-muted/40">
    <div class="py-16 lg:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="text-center mb-12">
          <h1 class="text-3xl md:text-4xl font-semibold text-foreground mb-4">
            Privacy Policy
          </h1>
          <div class="flex justify-center">
            <Badge variant="outline" className="text-sm">
              Last updated: December 2024
            </Badge>
          </div>
        </div>

        <section class="bg-card rounded-xl shadow-md p-8">
          <div class="space-y-8">
            <!-- Contact Details -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                Contact details
              </h2>
              <div class="space-y-4">
                <div>
                  <p
                    class="text-muted-foreground leading-relaxed mb-2 font-bold"
                  >
                    Post
                  </p>
                  <p class="text-muted-foreground leading-relaxed">
                    Springbrook Court, 5 Telegraph Avenue, LONDON, NW9 4GU, GB
                  </p>
                </div>
                <div>
                  <p
                    class="text-muted-foreground leading-relaxed mb-2 font-semibold"
                  >
                    Email
                  </p>
                  <p class="text-muted-foreground leading-relaxed">
                    hello@energy-i.ai
                  </p>
                </div>
              </div>
            </div>

            <!-- Information Collection -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                What information we collect, use, and why
              </h2>
              <div class="space-y-6">
                <div>
                  <p
                    class="text-muted-foreground leading-relaxed font-semibold mb-3"
                  >
                    We collect or use the following information to provide
                    services and goods, including delivery:
                  </p>
                  <ul
                    class="list-disc list-inside space-y-1 ml-4 text-muted-foreground"
                  >
                    <li>Names and contact details</li>
                    <li>Account information</li>
                    <li>
                      Website user information (including user journeys and
                      cookie tracking)
                    </li>
                    <li>Information relating to compliments or complaints</li>
                  </ul>
                </div>

                <div>
                  <p
                    class="text-muted-foreground leading-relaxed font-semibold mb-3"
                  >
                    We collect or use the following information for service
                    updates or marketing purposes:
                  </p>
                  <ul
                    class="list-disc list-inside space-y-1 ml-4 text-muted-foreground"
                  >
                    <li>Names and contact details</li>
                    <li>Addresses</li>
                    <li>Marketing preferences</li>
                    <li>Location data</li>
                    <li>IP addresses</li>
                    <li>Website and app user journey information</li>
                    <li>Records of consent, where appropriate</li>
                  </ul>
                </div>

                <div>
                  <p
                    class="text-muted-foreground leading-relaxed font-semibold mb-3"
                  >
                    We collect or use the following personal information for
                    dealing with queries, complaints or claims:
                  </p>
                  <ul
                    class="list-disc list-inside space-y-1 ml-4 text-muted-foreground"
                  >
                    <li>Names and contact details</li>
                    <li>Correspondence</li>
                  </ul>
                </div>

                <div>
                  <p
                    class="text-muted-foreground leading-relaxed font-semibold mb-3"
                  >
                    We collect or use the following information to manage our
                    waitlist, pilot-programme invitations and future account
                    activations:
                  </p>
                  <ul
                    class="list-disc list-inside space-y-1 ml-4 text-muted-foreground"
                  >
                    <li>Names and contact details</li>
                    <li>Addresses</li>
                    <li>IP addresses</li>
                    <li>Website and app user journey information</li>
                    <li>Company & sector information</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Lawful Bases -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                Lawful bases and data protection rights
              </h2>
              <div class="space-y-4 bg-muted/40 p-6 rounded-lg">
                <p class="text-muted-foreground leading-relaxed">
                  Under UK data protection law, we must have a "lawful basis"
                  for collecting and using your personal information. There is a
                  list of possible lawful bases in the UK GDPR. You can find out
                  more about
                  <a
                    href="https://ico.org.uk/for-organisations/advice-for-small-organisations/getting-started-with-gdpr/data-protection-principles-definitions-and-key-terms/#lawfulbasis"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:underline"
                  >
                    lawful bases
                  </a>
                  on the ICO's website.
                </p>
                <p class="text-muted-foreground leading-relaxed">
                  Which lawful basis we rely on may affect your data protection
                  rights which are set out in brief below. You can find out more
                  about your data protection rights and the exemptions which may
                  apply on the ICO's website:
                </p>

                <ul
                  class="list-disc list-inside space-y-3 ml-4 text-muted-foreground"
                >
                  <li>
                    <strong>Your right of access</strong> - You have the right to
                    ask us for copies of your personal information. You can request
                    other information such as details about where we get personal
                    information from and who we share personal information with. There
                    are some exemptions which means you may not receive all the information
                    you ask for.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/your-data-protection-rights/#roa"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right of access
                    </a>.
                  </li>
                  <li>
                    <strong>Your right to rectification</strong> - You have the right
                    to ask us to correct or delete personal information you think
                    is inaccurate or incomplete.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/your-data-protection-rights/#rtr"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right to rectification
                    </a>.
                  </li>
                  <li>
                    <strong>Your right to erasure</strong> - You have the right to
                    ask us to delete your personal information.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/your-data-protection-rights/#rte"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right to erasure
                    </a>.
                  </li>
                  <li>
                    <strong>Your right to restriction of processing</strong> - You
                    have the right to ask us to limit how we can use your personal
                    information.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/your-data-protection-rights/#rte"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right to restriction of processing
                    </a>.
                  </li>
                  <li>
                    <strong>Your right to object to processing</strong> - You have
                    the right to object to the processing of your personal data.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/privacy-notice-generator-for-customers-or-suppliers/general-business-including-retail-and-manufacture/generated-privacy-notice-general-business/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right to object to processing
                    </a>.
                  </li>
                  <li>
                    <strong>Your right to data portability</strong> - You have the
                    right to ask that we transfer the personal information you gave
                    us to another organisation, or to you.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/your-data-protection-rights/#rtdp"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right to data portability
                    </a>.
                  </li>
                  <li>
                    <strong>Your right to withdraw consent</strong> - When we use
                    consent as our lawful basis you have the right to withdraw your
                    consent at any time.
                    <a
                      href="https://ico.org.uk/for-organisations/advice-for-small-organisations/privacy-notices-and-cookies/create-your-own-privacy-notice/your-data-protection-rights/#rtwc"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline"
                    >
                      Read more about the right to withdraw consent
                    </a>.
                  </li>
                </ul>

                <p class="text-muted-foreground leading-relaxed">
                  If you make a request, we must respond to you without undue
                  delay and in any event within one month.
                </p>
                <p class="text-muted-foreground leading-relaxed">
                  To make a data protection rights request, please contact us
                  using the contact details at the top of this privacy notice.
                </p>
              </div>

              <div class="space-y-6 mt-8">
                <h3 class="text-xl font-semibold text-foreground mb-4">
                  Our lawful bases for the collection and use of your data
                </h3>

                <div class="space-y-6">
                  <div>
                    <p
                      class="text-muted-foreground leading-relaxed font-semibold mb-3"
                    >
                      Our lawful bases for collecting or using personal
                      information to provide services and goods are:
                    </p>
                    <ul
                      class="list-disc list-inside space-y-3 ml-4 text-muted-foreground"
                    >
                      <li>
                        <strong>Consent</strong> - we have permission from you after
                        we gave you all the relevant information. All of your data
                        protection rights may apply, except the right to object. To
                        be clear, you do have the right to withdraw your consent at
                        any time.
                      </li>
                      <li>
                        <strong>Legitimate interests</strong> - we're collecting or
                        using your information because it benefits you, our organisation
                        or someone else, without causing an undue risk of harm to
                        anyone. All of your data protection rights may apply, except
                        the right to portability. Our legitimate interests are:
                        <div class="mt-2 ml-4 space-y-2">
                          <p class="text-muted-foreground leading-relaxed">
                            We need to use your name, email address and phone
                            number to manage our waitlist, invite you to join
                            our pilot programme, and support you through
                            onboarding to the live service.
                          </p>
                          <p class="text-muted-foreground leading-relaxed">
                            <strong>Why it's necessary:</strong> Effective communication:
                            Without your contact details, we cannot let you know when
                            your place on the waitlist opens or when the pilot starts.
                            Timely support: If you submit a question or report an
                            issue, we need to reach you quickly to keep your experience
                            smooth.
                          </p>
                          <p class="text-muted-foreground leading-relaxed">
                            <strong
                              >Why the balance of interests falls in your
                              favour:
                            </strong> Benefit to you: You gain early access to our
                            pilot, timely answers to your queries, and clear updates
                            on when the full product is available. Minimal risk to
                            you: We only collect the minimum data needed (name + contact
                            + any optional message). We do not sell your data, share
                            it outside our core team, or collect any sensitive data.
                            Your control & safeguards: You can opt out of marketing
                            at any time via the unsubscribe link. All data is stored
                            securely (encrypted at rest), with access limited to our
                            support and product teams. We retain your details only
                            as long as you remain on the waitlist or pilot, unless
                            you give consent for marketing beyond that.
                          </p>
                        </div>
                      </li>
                    </ul>
                    <p class="text-muted-foreground leading-relaxed mt-3">
                      For more information on our use of legitimate interests as
                      a lawful basis you can contact us using the contact
                      details set out above.
                    </p>
                  </div>

                  <div>
                    <p
                      class="text-muted-foreground leading-relaxed font-semibold mb-3"
                    >
                      Our lawful bases for collecting or using personal
                      information for service updates or marketing purposes are:
                    </p>
                    <ul
                      class="list-disc list-inside space-y-2 ml-4 text-muted-foreground"
                    >
                      <li>
                        <strong>Consent</strong> - we have permission from you after
                        we gave you all the relevant information. All of your data
                        protection rights may apply, except the right to object. To
                        be clear, you do have the right to withdraw your consent at
                        any time.
                      </li>
                    </ul>
                  </div>

                  <div>
                    <p
                      class="text-muted-foreground leading-relaxed font-semibold mb-3"
                    >
                      Our lawful bases for collecting or using personal
                      information for dealing with queries, complaints or claims
                      are:
                    </p>
                    <ul
                      class="list-disc list-inside space-y-3 ml-4 text-muted-foreground"
                    >
                      <li>
                        <strong>Legitimate interests</strong> - we're collecting or
                        using your information because it benefits you, our organisation
                        or someone else, without causing an undue risk of harm to
                        anyone. All of your data protection rights may apply, except
                        the right to portability. Our legitimate interests are:
                        <div class="mt-2 ml-4">
                          <p class="text-muted-foreground leading-relaxed">
                            We need to use your name, contact details and
                            correspondence to investigate and resolve your query
                            or complaint in a timely, effective manner. This
                            processing is necessary for us to deliver the
                            service you've requested (i.e. a response or
                            resolution), and poses minimal privacy risk because
                            we only process what you voluntarily provide and do
                            not share it beyond our support team.
                          </p>
                        </div>
                      </li>
                    </ul>
                    <p class="text-muted-foreground leading-relaxed mt-3">
                      For more information on our use of legitimate interests as
                      a lawful basis you can contact us using the contact
                      details set out above.
                    </p>
                  </div>

                  <div>
                    <p
                      class="text-muted-foreground leading-relaxed font-semibold mb-3"
                    >
                      Our lawful bases for collecting or using personal
                      information for managing our waitlist, pilot-programme
                      invitations and future account activations are:
                    </p>
                    <ul
                      class="list-disc list-inside space-y-3 ml-4 text-muted-foreground"
                    >
                      <li>
                        <strong>Legitimate interests</strong> - we're collecting or
                        using your information because it benefits you, our organisation
                        or someone else, without causing an undue risk of harm to
                        anyone. All of your data protection rights may apply, except
                        the right to portability. Our legitimate interests are:
                        <div class="mt-2 ml-4">
                          <p class="text-muted-foreground leading-relaxed">
                            We process your name, email address, and phone
                            number so that we can effectively manage our
                            waitlist, invite you to participate in our pilot
                            programme, and onboard you onto the live service.
                            These communications are necessary and
                            proportionate: you have voluntarily provided this
                            information, we use it only for the stated purposes,
                            and we do not share it outside our core team. The
                            benefits to you, timely updates on your waitlist
                            status, clear pilot invitations, and a smooth
                            onboarding experience, far outweigh any minimal
                            privacy impact.
                          </p>
                        </div>
                      </li>
                    </ul>
                    <p class="text-muted-foreground leading-relaxed mt-3">
                      For more information on our use of legitimate interests as
                      a lawful basis you can contact us using the contact
                      details set out above.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Information Sources -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                Where we get personal information from
              </h2>
              <ul
                class="list-disc list-inside space-y-2 ml-4 text-muted-foreground"
              >
                <li>Directly from you</li>
                <li>Publicly available sources</li>
                <li>Market research organisations</li>
                <li>
                  Providers of marketing lists and other personal information
                </li>
                <li>
                  <strong>Third parties:</strong>
                  <div class="mt-2 ml-4">
                    <p class="text-muted-foreground leading-relaxed">
                      We may enrich the basic contact details you provide with
                      publicly available corporate information (e.g. Companies
                      House data) or via licensed marketing data providers, to
                      help us tailor our pilot invitations and account setup
                      process
                    </p>
                  </div>
                </li>
              </ul>
            </div>

            <!-- Retention Period -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                How long we keep information
              </h2>
              <div class="space-y-6">
                <div class="overflow-x-auto">
                  <table class="w-full border-collapse border border-border">
                    <thead>
                      <tr class="bg-muted/60">
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Data Category</th
                        >
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Purpose</th
                        >
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Retention Period</th
                        >
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Disposal Method</th
                        >
                      </tr>
                    </thead>
                    <tbody>
                      {
                        retentionRows.map((row, i) => (
                          <tr class={i % 2 === 1 ? "bg-muted/20" : ""}>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.category}
                            </td>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.purpose}
                            </td>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.period}
                            </td>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.disposal}
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>

                <p class="text-muted-foreground leading-relaxed">
                  For more information on how long we store your personal
                  information or the criteria we use to determine this please
                  contact us using the details provided above.
                </p>
              </div>
            </div>

            <!-- Information Sharing -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                Who we share information with
              </h2>
              <div class="space-y-6">
                <div>
                  <p
                    class="text-muted-foreground leading-relaxed font-semibold mb-3"
                  >
                    Data processors
                  </p>
                  <div class="space-y-4 ml-4">
                    <div>
                      <p
                        class="text-muted-foreground leading-relaxed font-medium"
                      >
                        Make.com / Integration platform
                      </p>
                      <p class="text-muted-foreground leading-relaxed">
                        This data processor does the following activities for
                        us: Receives form submissions via webhook and runs our
                        scenarios (writes to Sheets, sends email).
                      </p>
                    </div>
                    <div>
                      <p
                        class="text-muted-foreground leading-relaxed font-medium"
                      >
                        Google (Google Cloud / Sheets API) / Cloud data storage
                      </p>
                      <p class="text-muted-foreground leading-relaxed">
                        This data processor does the following activities for
                        us: Persists form-data rows in a Google Sheet (our
                        temporary CRM) and exposes them via API.
                      </p>
                    </div>
                  </div>
                </div>

                <div>
                  <p
                    class="text-muted-foreground leading-relaxed font-semibold mb-3"
                  >
                    Others we share personal information with
                  </p>
                  <div class="ml-4">
                    <p class="text-muted-foreground leading-relaxed">
                      Suppliers and service providers
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- International Transfers -->
            <div>
              <h2 class="text-2xl font-semibold text-foreground mb-6">
                Sharing information outside the UK
              </h2>
              <div class="space-y-6">
                <div class="space-y-4">
                  <p class="text-muted-foreground leading-relaxed">
                    Where necessary, we will transfer personal information
                    outside of the UK. When doing so, we comply with the UK
                    GDPR, making sure appropriate safeguards are in place.
                  </p>
                  <p class="text-muted-foreground leading-relaxed">
                    For further information or to obtain a copy of the
                    appropriate safeguard for any of the transfers below, please
                    contact us using the contact information provided above.
                  </p>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full border-collapse border border-border">
                    <thead>
                      <tr class="bg-muted/60">
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Organisation name</th
                        >
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Category of recipient</th
                        >
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Country</th
                        >
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Compliance safeguard</th
                        >
                      </tr>
                    </thead>
                    <tbody>
                      {
                        ourTransfers.map((row, i) => (
                          <tr class={i % 2 === 1 ? "bg-muted/20" : ""}>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.org}
                            </td>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.category}
                            </td>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.country}
                            </td>
                            <td class="border border-border px-4 py-3 text-muted-foreground">
                              {row.safeguard}
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>

                <div class="space-y-4">
                  <p class="text-muted-foreground leading-relaxed">
                    Where necessary, our data processors may share personal
                    information outside of the UK. When doing so, they comply
                    with the UK GDPR, making sure appropriate safeguards are in
                    place.
                  </p>
                  <p class="text-muted-foreground leading-relaxed">
                    For further information or to obtain a copy of the
                    appropriate safeguard for any of the transfers below, please
                    contact us using the contact information provided above.
                  </p>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full border-collapse border border-border">
                    <thead>
                      <tr class="bg-muted/60">
                        <th
                          class="border border-border px-4 py-3 text-left font-semibold text-foreground"
                          >Organisation name</th
                        >
                        <th
